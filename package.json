{
	"name": "vexwave",
	"version": "1.0.0",
	"description": "VexWave — a desktop music player built with Electrobun, React, Tailwind CSS, and Vite HMR",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary"
	},
	"dependencies": {
		"@radix-ui/react-context-menu": "^2.3.3",
		"@radix-ui/react-dialog": "^1.1.19",
		"@radix-ui/react-progress": "^1.1.12",
		"@radix-ui/react-scroll-area": "^1.2.14",
		"@radix-ui/react-separator": "^1.1.11",
		"@radix-ui/react-slider": "^1.4.3",
		"@radix-ui/react-slot": "^1.3.0",
		"@ts-rest/core": "3.53.0-rc.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electrobun": "1.18.1",
		"lucide-react": "^1.24.0",
		"music-metadata": "^11.13.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/three": "^0.185.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.16",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
