{
	"name": "vexwave",
	"version": "1.0.0",
	"description": "VexWave — a desktop music player built with Electrobun, React, Tailwind CSS, and Vite HMR",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "bun run --parallel \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"lint": "tsc --noEmit",
		"vite:build": "vite build",
		"build:canary": "vite build && electrobun build --env=canary",
		"build:stable": "electrobun build --env=stable",
		"build:installer:stable": "bun run vite:build && bun run build:stable && bun run scripts/fuse-installer.ts stable",
		"build:installer:canary": "bun run build:canary && bun run scripts/fuse-installer.ts canary",
		"release": "bun run scripts/release.ts"
	},
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/modifiers": "9.0.0",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@radix-ui/react-context-menu": "^2.4.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-progress": "^1.2.1",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slider": "^1.6.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@ts-rest/core": "3.53.0-rc.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electrobun": "1.18.1",
		"lucide-react": "^1.61.0",
		"music-metadata": "^11.16.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@types/three": "^0.185.4",
		"@vitejs/plugin-react": "^4.7.0",
		"autoprefixer": "^10.6.1",
		"postcss": "^8.5.31",
		"rcedit": "4.0.1",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^7.0.2",
		"vite": "^6.4.5"
	}
}
