// The scripts here run under bun alone, so they are checked apart from the app:
// the root config hands the webview `DOM`, whose `BodyInit`/`Response` clash
// with bun's own globals over the very types a server hands around. Without
// this the test server is checked by nothing at all, and a contract change it
// no longer matches — a `RoutePolicy` field that lost a value, say — goes
// unnoticed until a manual run behaves oddly.
{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2022"],
		"types": ["bun"]
	},
	"include": ["."]
}
